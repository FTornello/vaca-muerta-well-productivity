  <worksheets>
    <worksheet name='Cuatro áreas dieron el 62 % del petróleo, y pierden peso'>
      <table>
        <view>
          <datasources>
            <datasource caption='pozos+ (vaca_muerta_tablero)' name='federated.0lz6sbs19ye4771ddctm902qbnm5' />
          </datasources>
          <datasource-dependencies datasource='federated.0lz6sbs19ye4771ddctm902qbnm5'>
            <column caption='Área productora' datatype='string' name='[Calculation_1499839467845337108]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [area (produccion!por!area)]=&apos;LOMA CAMPANA&apos; THEN &apos;1. Loma Campana&apos; ELSEIF [area (produccion!por!area)]=&apos;LA AMARGA CHICA&apos; THEN &apos;2. La Amarga Chica&apos; ELSEIF [area (produccion!por!area)]=&apos;BANDURRIA SUR&apos; THEN &apos;3. Bandurria Sur&apos; ELSEIF [area (produccion!por!area)]=&apos;BAJADA DEL PALO OESTE&apos; THEN &apos;4. Bajada del Palo Oeste&apos; ELSE &apos;5. Resto (89 áreas)&apos; END' />
            </column>
            <column caption='Area (Produccion!Por!Area)' datatype='string' name='[area (produccion!por!area)]' role='dimension' type='nominal' />
            <column caption='Fecha' datatype='date' name='[mes]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1499839467845337108]' derivation='None' name='[none:Calculation_1499839467845337108:nk]' pivot='key' type='nominal' />
            <column caption='Petroleo M3 (Produccion!Por!Area)' datatype='integer' name='[petroleo_m3 (produccion!por!area)]' role='measure' type='quantitative' />
            <column-instance column='[petroleo_m3 (produccion!por!area)]' derivation='Sum' name='[sum:petroleo_m3 (produccion!por!area):qk]' pivot='key' type='quantitative' />
            <column-instance column='[mes]' derivation='None' name='[none:mes:qk]' pivot='key' type='quantitative' />
            <column-instance column='[mes]' derivation='Month-Trunc' name='[tmn:mes:qk]' pivot='key' type='quantitative' />
            <style />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.0lz6sbs19ye4771ddctm902qbnm5].[none:mes:qk]' included-values='in-range'>
            <min>#2018-01-01#</min>
            <max>#2030-12-31#</max>
          </filter>
          <slices>
            <column>[federated.0lz6sbs19ye4771ddctm902qbnm5].[none:mes:qk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.0lz6sbs19ye4771ddctm902qbnm5].[sum:petroleo_m3 (produccion!por!area):qk]' scope='rows' value='Petróleo por mes (m³)' />
