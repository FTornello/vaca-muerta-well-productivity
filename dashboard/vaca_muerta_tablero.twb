      <column caption='Área productora' datatype='string' name='[Calculation_1499839467845337108]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [area (produccion!por!area)]=&apos;LOMA CAMPANA&apos; THEN &apos;1. Loma Campana&apos; ELSEIF [area (produccion!por!area)]=&apos;LA AMARGA CHICA&apos; THEN &apos;2. La Amarga Chica&apos; ELSEIF [area (produccion!por!area)]=&apos;BANDURRIA SUR&apos; THEN &apos;3. Bandurria Sur&apos; ELSEIF [area (produccion!por!area)]=&apos;BAJADA DEL PALO OESTE&apos; THEN &apos;4. Bajada del Palo Oeste&apos; ELSE &apos;5. Resto (89 áreas)&apos; END' />
